# Copy to .env.local and fill in. Never commit real keys.
# Local development: Gemini Developer API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional comma-separated model list, tried in order.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# Production uses Vertex AI through the Cloud Run service account instead of a key:
# GEMINI_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
